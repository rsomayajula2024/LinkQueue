{
  "manifest_version": 3,
  "name": "LinkQueue",
  "version": "1.5.0",
  "description": "Save profiles to invite later when your weekly invite limit is hit. Get a reminder when it resets. Free, private, no tracking.",
  "permissions": ["storage", "alarms", "notifications", "contextMenus"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "LinkQueue – open queue" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
